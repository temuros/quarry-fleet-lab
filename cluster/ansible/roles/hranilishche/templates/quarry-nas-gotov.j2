#!/bin/sh
# Готова обслуживать только машина, чья копия данных полная и чьё право быть
# главной никто не оспаривает. Разложено ролью hranilishche.
#
# 🔴 Проверка копии это ответ на первое учение: погашенная машина вернулась,
# VRRP отдал ей адрес по старшинству, а диск у неё был ещё Inconsistent, и
# хранилище перестало отдавать том, хотя вторая машина была цела и свежа.
#
# 🔴 Право быть главной это ответ на разрыв канала между машинами. Две
# стороны не отличают «сосед умер» от «связь с соседом пропала»: картина
# одинаковая. Каждая берёт том в запись, копии расходятся необратимо, а
# большинства из двух голосов не бывает. Поэтому есть третий, вне обеих.
#
# 🔴 Действующая главная держит право ПОСТОЯННО, а не берёт его в момент
# разрыва. Это выяснилось учением: сначала замок брали только при потере
# связи, и на разрыве его успевала взять вторая машина, потому что первая
# ни о чём не просила, она уже была главной. В итоге том оказывался в
# записи с обеих сторон на десяток секунд.
#
# ⚠️ Ведомая машина при живом канале арбитра не спрашивает: спорить не о
# чем, DRBD сам не даст двум сторонам стать Primary. Поэтому упавший арбитр
# не мешает работе пары, он мешает только переезду во время разрыва, когда
# переезжать и не следует.
set -u

ARBITR="http://{{ nas_shlyuz }}:{{ nas_arbitr_port }}/zamok"
IMYA="$(hostname)"

# Копия данных должна быть полной: с неполной обслуживать нельзя.
drbdadm status quarry 2>/dev/null | grep -q 'disk:UpToDate' || exit 1

# ⚠️ Состояние связи спрашиваем отдельной командой, а не грепом по выводу
# `status`. В нём строка `connection:Connected` появляется не всегда: у
# стороны, видящей живого соседа, печатается `replication:Established`, и
# греп по первому варианту молча считает соседа пропавшим.
svyaz="$(drbdadm cstate quarry 2>/dev/null || echo '?')"
# ⚠️ `drbdadm role` печатает «Primary/Secondary»: своя роль и роль соседа.
rol="$(drbdadm role quarry 2>/dev/null | cut -d/ -f1)"

# Ведомая при живом канале: спора нет и права не нужно.
if [ "$rol" = "Secondary" ] && [ "$svyaz" = "Connected" ]; then
    exit 0
fi

# Во всех остальных случаях (мы главная либо соседа не видно) право надо
# иметь. Держатель продлевает аренду этим же запросом, второй получает отказ.
curl -sf --max-time 2 "$ARBITR?kto=$IMYA" >/dev/null 2>&1
otvet=$?
[ "$otvet" -eq 0 ] && exit 0

# ⚠️ Отказ арбитра и молчание арбитра это разные вещи. Код 22 означает, что
# он ответил «занято»: главная уже есть, и претендовать нельзя. Любой другой
# код означает, что арбитра нет; тогда при живом канале работаем как раньше,
# потому что DRBD сам не даст двум сторонам стать главными.
if [ "$otvet" -ne 22 ] && [ "$svyaz" = "Connected" ]; then
    exit 0
fi

logger 'quarry-nas: право быть главной не получено, на общий адрес не претендую'
exit 1
