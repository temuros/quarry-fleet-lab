#!/bin/sh
# Машина стала главной: поднять реплику в режим записи, смонтировать том,
# включить отдачу. Разложено ролью hranilishche.
set -e
# ⚠️ Реплику поднимаем явно: после перезагрузки машины ресурс DRBD может быть
# не поднят, и тогда «стать главным» молча не срабатывает.
drbdadm up quarry 2>/dev/null || true

# 🔴 Ждём, пока прежняя главная отпустит роль.
#
# При гашении машины вторая сторона мертва мгновенно, и захват проходит с
# первой попытки. При ПЛАНОВОМ переключении обе машины живы, и новая главная
# получает адрес на секунду-две раньше, чем старая успевает стать ведомой.
# Раньше здесь стоял один вызов `drbdadm primary`: он падал на «отказано»,
# `set -e` обрывал скрипт, и хранилище оставалось без хозяина совсем, хотя
# обе машины были целы. Молчаливый отказ на ровном месте, ровно в том
# сценарии, который на площадке случается чаще всего.
popytka=0
until drbdadm primary quarry 2>/dev/null; do
    popytka=$((popytka + 1))
    if [ "$popytka" -ge 30 ]; then
        logger 'quarry-nas: не удалось стать главным за 30 секунд, вторая машина держит том'
        exit 1
    fi
    sleep 1
done
mountpoint -q {{ nas_katalog }} || mount /dev/drbd0 {{ nas_katalog }}
systemctl start nfs-kernel-server
exportfs -ra
logger 'quarry-nas: стал главным, том отдан'
