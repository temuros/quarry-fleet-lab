#!/bin/sh
# Машина стала главной: поднять реплику в режим записи, смонтировать том,
# включить отдачу. Разложено ролью hranilishche.
set -e
# ⚠️ Реплику поднимаем явно: после перезагрузки машины ресурс DRBD может быть
# не поднят, и тогда «стать главным» молча не срабатывает.
drbdadm up quarry 2>/dev/null || true

# 🔴 Право быть главной спрашиваем ВСЕГДА, до того как трогаем диск.
#
# Сначала здесь стояло условие «спрашивать, только если соседа не видно», и
# учение показало, почему так нельзя: VRRP замечает пропажу соседа за пару
# секунд, а DRBD за десяток. В эту разницу машина успевает решить, что связь
# ещё цела, ничего не спросить и взять том в запись, пока вторая сторона
# уже стала главной. Обе побывали Primary секунд по десять.
#
# Теперь право нужно всегда. Занятое право означает, что главная уже есть.
curl -sf --max-time 2 "http://{{ nas_shlyuz }}:{{ nas_arbitr_port }}/zamok?kto=$(hostname)" >/dev/null 2>&1
otvet=$?
if [ "$otvet" -ne 0 ]; then
    # ⚠️ Отказ арбитра и молчание арбитра это разные вещи. Код 22 означает,
    # что он ответил «занято»: право у соседа, и брать том нельзя. Любой
    # другой код означает, что арбитра просто нет, и тогда решаем по связи:
    # при живом канале DRBD сам не даст двум сторонам стать главными.
    if [ "$otvet" -eq 22 ]; then
        logger 'quarry-nas: право быть главной занято соседом, том не беру'
        exit 1
    fi
    if [ "$(drbdadm cstate quarry 2>/dev/null)" != "Connected" ]; then
        logger 'quarry-nas: арбитр молчит и соседа не видно, том не беру'
        exit 1
    fi
    logger 'quarry-nas: арбитр молчит, но канал реплики цел, продолжаю'
fi

# 🔴 Ждём, пока прежняя главная отпустит роль.
#
# При гашении машины вторая сторона мертва мгновенно, и захват проходит с
# первой попытки. При ПЛАНОВОМ переключении обе машины живы, и новая главная
# получает адрес на секунду-две раньше, чем старая успевает стать ведомой.
# Раньше здесь стоял один вызов `drbdadm primary`: он падал на «отказано»,
# `set -e` обрывал скрипт, и хранилище оставалось без хозяина совсем, хотя
# обе машины были целы. Молчаливый отказ на ровном месте, ровно в том
# сценарии, который на площадке случается чаще всего.
popytka=0
until drbdadm primary quarry 2>/dev/null; do
    popytka=$((popytka + 1))
    if [ "$popytka" -ge 30 ]; then
        logger 'quarry-nas: не удалось стать главным за 30 секунд, вторая машина держит том'
        exit 1
    fi
    sleep 1
done
mountpoint -q {{ nas_katalog }} || mount /dev/drbd0 {{ nas_katalog }}
systemctl start nfs-kernel-server
exportfs -ra
logger 'quarry-nas: стал главным, том отдан'
