{# Описание ресурса DRBD. Конфигурация на обеих машинах совпадает до байта,
   иначе DRBD отказывается собирать пару. #}
# Разложено ролью hranilishche.
resource quarry {
  protocol C;                 # запись подтверждается, когда её приняли обе машины
  device    /dev/drbd0;
  disk      {{ nas_disk }};
  meta-disk internal;

  net {
    # Расхождение после разрыва связи разбираем автоматически в пользу той
    # стороны, где меньше несогласованных изменений: на стенде это лучше, чем
    # ждать человека, а на площадке сюда ставят ручной разбор.
    after-sb-0pri discard-zero-changes;
    after-sb-1pri discard-secondary;
    after-sb-2pri disconnect;

    # ⚠️ По умолчанию DRBD замечает пропажу соседа только через десять
    # секунд, а VRRP через три. В эту разницу вторая машина успевает поднять
    # общий адрес, считая канал целым, и он на десяток секунд оказывается
    # поднят на обеих. Данные это не портит (том берёт только держатель
    # права), но выглядит как раздвоение и путает разбор. Три секунды дают
    # запас против случайной потери пакета и не дают разъехаться с VRRP.
    ping-int 3;
    ping-timeout 10;   # десятые доли секунды, то есть одна секунда
  }

  # ⚠️ Без node-id: он нужен только схемам больше чем на две машины, а
  # здешние утилиты на него отвечают невнятным «Parse error ... but got
  # node-id», и ресурс просто не собирается.
{% for imya, ip in nas_sosedi.items() %}
  on {{ imya }} {
    address {{ ip }}:7789;
  }
{% endfor %}
}
