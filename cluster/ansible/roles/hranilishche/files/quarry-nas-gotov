#!/bin/sh
# Готова обслуживать только машина, чья копия данных полная.
#
# 🔴 Это и есть ответ на первое учение: погашенная машина вернулась, VRRP
# отдал ей адрес по старшинству, а диск у неё был ещё Inconsistent, и
# хранилище перестало отдавать том, хотя вторая машина была цела и свежа.
drbdadm status quarry 2>/dev/null | grep -q 'disk:UpToDate' || exit 1
exit 0
