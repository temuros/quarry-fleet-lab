{
  "uid": "quarry-main",
  "title": "Карьер: горнотранспортный комплекс",
  "tags": ["quarry", "oes"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "Тонн в час",
      "description": "Скользящее окно два часа карьера. Синий: динамическое назначение самосвалов. Оранжевый: самосвалы закреплены за забоем.",
      "datasource": { "type": "prometheus", "uid": "quarry-prom" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "балансировка" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4C8DFF" } }]
          },
          {
            "matcher": { "id": "byName", "options": "закреплены за забоем" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D2701F" } }]
          }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "quarry_tons_per_hour{strategy=\"balanced\"}", "legendFormat": "балансировка" },
        { "refId": "B", "expr": "quarry_tons_per_hour{strategy=\"fixed\"}", "legendFormat": "закреплены за забоем" }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Выигрыш балансировки",
      "description": "Насколько больше горной массы вывозит тот же парк при динамическом назначении.",
      "datasource": { "type": "prometheus", "uid": "quarry-prom" },
      "gridPos": { "h": 6, "w": 5, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#8E8E8E", "value": null },
              { "color": "#4C8DFF", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(quarry_tons_per_hour{strategy=\"balanced\"} / on() quarry_tons_per_hour{strategy=\"fixed\"} - 1) * 100",
          "legendFormat": "выигрыш"
        }
      ]
    },
    {
      "type": "gauge",
      "id": 3,
      "title": "Доступность потока данных",
      "description": "Требование площадки: не ниже 95 процентов. Считается по секундам, в которые телеметрия дошла с задержкой меньше 5 секунд.",
      "datasource": { "type": "prometheus", "uid": "quarry-prom" },
      "gridPos": { "h": 6, "w": 6, "x": 13, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#C4162A", "value": null },
              { "color": "#E0B400", "value": 0.9 },
              { "color": "#3D8F4B", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "targets": [
        { "refId": "A", "expr": "quarry_stream_uptime_ratio", "legendFormat": "{{fleet}}" }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Задержка приёма",
      "description": "Требование площадки: меньше 5 секунд. Во время обрыва канала растёт, после восстановления спадает по мере догона буфера.",
      "datasource": { "type": "prometheus", "uid": "quarry-prom" },
      "gridPos": { "h": 6, "w": 5, "x": 19, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#3D8F4B", "value": null },
              { "color": "#E0B400", "value": 3 },
              { "color": "#C4162A", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "orientation": "horizontal"
      },
      "targets": [
        { "refId": "A", "expr": "quarry_ingest_lag_seconds", "legendFormat": "{{fleet}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Производительность, тонн в час",
      "datasource": { "type": "prometheus", "uid": "quarry-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "балансировка" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4C8DFF" } }]
          },
          {
            "matcher": { "id": "byName", "options": "закреплены за забоем" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D2701F" } }]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "quarry_tons_per_hour{strategy=\"balanced\"}", "legendFormat": "балансировка" },
        { "refId": "B", "expr": "quarry_tons_per_hour{strategy=\"fixed\"}", "legendFormat": "закреплены за забоем" }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Время рейса, минуты",
      "datasource": { "type": "prometheus", "uid": "quarry-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "балансировка" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4C8DFF" } }]
          },
          {
            "matcher": { "id": "byName", "options": "закреплены за забоем" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D2701F" } }]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "quarry_cycle_seconds_avg{strategy=\"balanced\"} / 60", "legendFormat": "балансировка" },
        { "refId": "B", "expr": "quarry_cycle_seconds_avg{strategy=\"fixed\"} / 60", "legendFormat": "закреплены за забоем" }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Ожидание под погрузку, минуты",
      "datasource": { "type": "prometheus", "uid": "quarry-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "балансировка" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4C8DFF" } }]
          },
          {
            "matcher": { "id": "byName", "options": "закреплены за забоем" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D2701F" } }]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "quarry_wait_seconds_avg{strategy=\"balanced\"} / 60", "legendFormat": "балансировка" },
        { "refId": "B", "expr": "quarry_wait_seconds_avg{strategy=\"fixed\"} / 60", "legendFormat": "закреплены за забоем" }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Простой экскаваторов",
      "description": "Доля времени, когда у экскаватора нет самосвала под погрузкой.",
      "datasource": { "type": "prometheus", "uid": "quarry-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "балансировка.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4C8DFF" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "закреплены.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D2701F" } }]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "quarry_excavator_idle_ratio{strategy=\"balanced\"}", "legendFormat": "балансировка, {{excavator}}" },
        { "refId": "B", "expr": "quarry_excavator_idle_ratio{strategy=\"fixed\"}", "legendFormat": "закреплены, {{excavator}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Очередь у забоя, самосвалов",
      "datasource": { "type": "prometheus", "uid": "quarry-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "spanNulls": true, "axisSoftMax": 4 }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "балансировка.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4C8DFF" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "закреплены.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D2701F" } }]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "quarry_queue_len{strategy=\"balanced\"}", "legendFormat": "балансировка, {{excavator}}" },
        { "refId": "B", "expr": "quarry_queue_len{strategy=\"fixed\"}", "legendFormat": "закреплены, {{excavator}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Самосвалы по состояниям, парк с балансировкой",
      "datasource": { "type": "prometheus", "uid": "quarry-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "quarry_trucks{strategy=\"balanced\"}", "legendFormat": "{{state}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Поток телеметрии, сообщений в секунду",
      "description": "Провал и последующий всплеск, это обрыв канала и догон накопленного буфера.",
      "datasource": { "type": "prometheus", "uid": "quarry-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#4C8DFF" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(quarry_messages_total[1m]))", "legendFormat": "принято сообщений" }
      ]
    }
  ]
}
