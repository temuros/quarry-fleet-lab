{
  "uid": "quarry-main",
  "title": "Карьер: горнотранспортный комплекс",
  "tags": [
    "quarry",
    "telemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "Тонн в час",
      "description": "Скользящее окно два часа карьера. Синий: динамическое назначение самосвалов. Оранжевый: самосвалы закреплены за забоем.",
      "datasource": {
        "type": "prometheus",
        "uid": "quarry-prom"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "балансировка"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4C8DFF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "закреплены за забоем"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#D2701F"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quarry_tons_per_hour{strategy=\"balanced\"}",
          "legendFormat": "балансировка"
        },
        {
          "refId": "B",
          "expr": "quarry_tons_per_hour{strategy=\"fixed\"}",
          "legendFormat": "закреплены за забоем"
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Выигрыш балансировки",
      "description": "Насколько больше горной массы вывез тот же парк при динамическом назначении, накопительно за весь прогон. Первые часы карьера цифра скачет, ей нужно несколько рейсов.",
      "datasource": {
        "type": "prometheus",
        "uid": "quarry-prom"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8E8E8E",
                "value": null
              },
              {
                "color": "#4C8DFF",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(quarry_tons_total{strategy=\"balanced\"}) / sum(quarry_tons_total{strategy=\"fixed\"}) - 1) * 100",
          "legendFormat": "выигрыш"
        }
      ]
    },
    {
      "type": "gauge",
      "id": 3,
      "title": "Доступность потока данных",
      "description": "Требование площадки: не ниже 95 процентов. Считается по секундам, в которые телеметрия дошла с задержкой меньше 5 секунд.",
      "datasource": {
        "type": "prometheus",
        "uid": "quarry-prom"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 13,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C4162A",
                "value": null
              },
              {
                "color": "#E0B400",
                "value": 0.9
              },
              {
                "color": "#3D8F4B",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quarry_stream_uptime_ratio",
          "legendFormat": "{{fleet}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Задержка приёма",
      "description": "Требование площадки: меньше 5 секунд. Во время обрыва канала растёт, после восстановления спадает по мере догона буфера.",
      "datasource": {
        "type": "prometheus",
        "uid": "quarry-prom"
