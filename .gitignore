__pycache__/

# Снимки и следы Playwright: делаются на прогоне, в репозиторий не едут.
.playwright-mcp/
*.pyc
.env

# кластер: состояние, ключи и доступы наружу не уезжают
cluster/**/kubeconfig
# ⚠️ Звёздочка, а не сам каталог: в исключённый целиком каталог git не
# заходит, и никакое «!» внутри него уже не работает.
cluster/artifacts/*
# Хроники учений это не артефакт сборки, а результат работы: по ним видно,
# что и когда гасили и как система себя вела. README на них ссылается,
# поэтому они едут в репозиторий, в отличие от образов рядом.
!cluster/artifacts/drills/
cluster/k3s/artifacts/
cluster/terraform/.terraform/
cluster/terraform/terraform.tfstate*
cluster/terraform/*.tfvars
cluster/kubespray/inventory/quarry/hosts.yaml
cluster/kubespray/kubeconfig

# Инвентарь Kubespray собирается deploy.sh под текущие адреса машин.
# Исходники лежат в репозитории: cluster/kubespray/profile.yml и
# cluster/offline/render-offline-vars.sh.
cluster/kubespray/inventory/quarry/group_vars/all/offline.yml
cluster/kubespray/inventory/quarry/group_vars/k8s_cluster/profile.yml
